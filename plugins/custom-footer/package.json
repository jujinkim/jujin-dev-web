{
  "name": "@jujinkim/quartz-custom-footer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup src/index.ts src/components/index.tsx --tsconfig tsconfig.json --format esm --dts --clean --external preact --external @quartz-community/types"
  },
  "peerDependencies": {
    "@quartz-community/types": "^0.3.0",
    "preact": "^10.0.0"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^7.0.2"
  },
  "quartz": {
    "name": "custom-footer",
    "displayName": "Custom Footer",
    "description": "Site footer matching previous Quartz design.",
    "category": "component",
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "components": {
      "CustomFooter": {
        "name": "custom-footer",
        "displayName": "Custom Footer",
        "description": "Site footer matching previous Quartz design.",
        "version": "1.0.0",
        "defaultPosition": "footer",
        "defaultPriority": 50
      }
    }
  }
}
