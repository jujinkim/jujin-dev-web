{
  "name": "@jujinkim/quartz-localized-recent-notes",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup src/index.ts src/components/index.ts --tsconfig tsconfig.json --format esm --dts --clean --external @quartz-community/recent-notes --external @quartz-community/types"
  },
  "peerDependencies": {
    "@quartz-community/recent-notes": "^0.1.0",
    "@quartz-community/types": "^0.3.0"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "quartz": {
    "name": "localized-recent-notes",
    "displayName": "Localized Recent Notes",
    "description": "Recent notes in the active language with Korean-original fallback.",
    "category": "component",
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "components": {
      "LocalizedRecentNotes": {
        "name": "localized-recent-notes",
        "displayName": "Localized Recent Notes",
        "description": "Recent notes in the active language with Korean-original fallback.",
        "version": "1.0.0",
        "defaultPosition": "left",
        "defaultPriority": 25
      }
    }
  }
}
